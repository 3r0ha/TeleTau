{
  "name": "teletau",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:seed": "pnpm --filter @teletau/api demo:seed",
    "build": "turbo run build",
    "lint": "turbo run lint && node scripts/check-hardcoded-colors.mjs && node scripts/check-hardcoded-tokens.mjs && node scripts/check-content.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test 'scripts/test/*.test.mjs'",
    "vectors": "pnpm --filter @teletau/bashkir-text --filter @teletau/auth-codes --filter @teletau/domain-rules test",
    "codegen": "node packages/bashkir-text/scripts/codegen.mjs && pnpm --filter @teletau/design-tokens build && node scripts/prepare-audio.mjs",
    "codegen:check": "node packages/bashkir-text/scripts/codegen.mjs --check && pnpm --filter @teletau/design-tokens check-generated && node scripts/prepare-audio.mjs --check",
    "audio": "node scripts/prepare-audio.mjs",
    "contracts:check": "pnpm --filter @teletau/contracts check",
    "tokens:check": "pnpm --filter @teletau/design-tokens test",
    "db:migrate": "pnpm --filter @teletau/api db:migrate",
    "e2e": "pnpm --filter @teletau/e2e e2e",
    "format": "prettier --write .",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "wasm-media-encoders": "^0.7.0",
    "yaml": "^2.8.0"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.8"
    }
  }
}
