{
  "name": "@teletau/bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram-бот: канально-независимое ядро диалогов + адаптер Telegram (grammY, long polling), напоминания о серии по согласию (ADR 0007, 0020).",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/run-ts-app.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@teletau/contracts": "workspace:*",
    "grammy": "^1.46.0",
    "zod": "^4.6.7",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^5.0.5"
  }
}
