{
  "name": "@teletau/ml-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Пакетные расчёты на TypeScript: Dawid–Skene, Bradley–Terry, симулятор консенсуса (с M4). В M0 — каркас.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/run-ts-app.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^5.0.5"
  }
}
