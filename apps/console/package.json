{
  "name": "@teletau/console",
  "version": "0.1.0",
  "private": true,
  "description": "Консоль внутренних ролей: эксперт, модератор, контент, Фонд, министерство, администратор.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port ${CONSOLE_PORT:-3100}",
    "build": "next build",
    "start": "next start --port ${CONSOLE_PORT:-3100}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app test proxy.ts instrumentation.ts",
    "test": "vitest run",
    "test:a11y": "playwright test"
  },
  "dependencies": {
    "@teletau/contracts": "workspace:*",
    "@teletau/design-tokens": "workspace:*",
    "@teletau/session": "workspace:*",
    "@teletau/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest": "^5.0.5"
  }
}
