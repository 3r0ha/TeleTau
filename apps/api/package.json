{
  "name": "@teletau/api",
  "version": "0.1.0",
  "private": true,
  "description": "Модульный монолит API «ТелеТау» (NestJS + Fastify).",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/run-ts-app.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts && node scripts/boundaries.mjs",
    "test": "vitest run --project unit",
    "test:integration": "node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "org:import": "node --env-file-if-exists=../../.env src/modules/org/directory-import.ts",
    "content:import": "node --env-file-if-exists=../../.env src/modules/content/content-import.ts",
    "corpus:import": "node --env-file-if-exists=../../.env src/modules/corpus/duels-import.ts",
    "demo:seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/demo/seed.js"
  },
  "dependencies": {
    "@teletau/auth-codes": "workspace:*",
    "@teletau/bashkir-text": "workspace:*",
    "@teletau/contracts": "workspace:*",
    "@teletau/design-tokens": "workspace:*",
    "@teletau/domain-rules": "workspace:*",
    "@teletau/runtime": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "otplib": "^13.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.21",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.5.438",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
