{
  "name": "@teletau/ai-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Шлюз к GigaChat: вызовы LLM только здесь (ADR 0008) — реестр промптов, валидатор закрытого словаря, таймауты. Функция 1 «Объяснение ошибки».",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/run-ts-app.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "undici": "^7.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^5.0.5"
  }
}
