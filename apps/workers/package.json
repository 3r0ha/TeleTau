{
  "name": "@teletau/workers",
  "version": "0.1.0",
  "private": true,
  "description": "Фоновые задачи (BullMQ): уведомления, релизы датасета, пересчёт рейтингов.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/run-ts-app.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@teletau/runtime": "workspace:*",
    "bullmq": "^6.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^5.0.5"
  }
}
