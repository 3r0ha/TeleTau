{
  "name": "@teletau/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Компоненты «ТелеТау» v2 («Тропа + Экспедиция») для веба и консоли: React + ui.css на дизайн-токенах. Пакет без сборки — исходники транслирует Next.js (transpilePackages).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ui.css": "./src/ui.css",
    "./shell.css": "./src/shell.css",
    "./files": "./src/files.ts",
    "./theme-cookie": "./src/theme-cookie.ts",
    "./strings": "./src/strings.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@teletau/design-tokens": "workspace:*",
    "@phosphor-icons/react": "^2.1.10"
  },
  "peerDependencies": {
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^5.0.5"
  }
}
