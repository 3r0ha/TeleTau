{
  "name": "@teletau/auth-codes",
  "version": "0.1.0",
  "private": true,
  "description": "QR-карточки и коды классов: генерация, разбор, контрольная сумма, нормализация ручного ввода (ADR 0016). Эталон для общих тест-векторов.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "^4.0.0",
    "vitest": "^5.0.5"
  }
}
