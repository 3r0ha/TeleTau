{
  "suite": "consensus/duel-v0",
  "version": 1,
  "function": "duelV0",
  "description": "duelV0({ votes }) — состояние дуэли по правилам v0 до Consensus Engine (ADR 0019, docs/03 §4a): веса ребёнок 1, взрослый 2, учитель 3; эксперт решает окончательно; без голосов учителей и взрослых — voting; большинства учителей и взрослых расходятся — escalated; иначе при ≥ 3 голосах и взвешенном перевесе ≥ 2 — accepted (both — по 0,5 веса обоим); большинство детей не совпало с итогом — childrenPrefer. votes — в порядке времени; у участника учитывается последний голос. Правила — README.md этого каталога.",
  "cases": [
    { "id": "c001", "input": { "votes": [] }, "expected": { "status": "voting", "accepted": [], "main": null, "decidedBy": null, "childrenPrefer": null, "weighted": { "a": 0, "b": 0 }, "counted": 0 }, "note": "голосов нет" },
    { "id": "c002", "input": { "votes": [{ "voter": "c1", "group": "child", "choice": "a" }, { "voter": "c2", "group": "child", "choice": "a" }, { "voter": "c3", "group": "child", "choice": "a" }, { "voter": "c4", "group": "child", "choice": "a" }, { "voter": "c5", "group": "child", "choice": "a" }] }, "expected": { "status": "voting", "accepted": [], "main": null, "decidedBy": null, "childrenPrefer": null, "weighted": { "a": 5, "b": 0 }, "counted": 5 }, "note": "голосами одних детей вариант не принимается" },
    { "id": "c003", "input": { "votes": [{ "voter": "c1", "group": "child", "choice": "a" }, { "voter": "c2", "group": "child", "choice": "a" }, { "voter": "c3", "group": "child", "choice": "a" }, { "voter": "t1", "group": "teacher", "choice": "a" }] }, "expected": { "status": "accepted", "accepted": ["a"], "main": "a", "decidedBy": "rule", "childrenPrefer": null, "weighted": { "a": 6, "b": 0 }, "counted": 4 }, "note": "3 голоса детей и 1 учителя — принят (сценарий показа)" },
    { "id": "c004", "input": { "votes": [{ "voter": "t1", "group": "teacher", "choice": "a" }, { "voter": "u1", "group": "adult", "choice": "a" }] }, "expected": { "status": "voting", "accepted": [], "main": null, "decidedBy": null, "childrenPrefer": null, "weighted": { "a": 5, "b": 0 }, "counted": 2 }, "note": "меньше 3 голосов — ещё голосуем, как бы ни был велик перевес" },
    { "id": "c005", "input": { "votes": [{ "voter": "u1", "group": "adult", "choice": "a" }, { "voter": "u2", "group": "adult", "choice": "a" }, { "voter": "c1", "group": "child", "choice": "b" }] }, "expected": { "status": "accepted", "accepted": ["a"], "main": "a", "decidedBy": "rule", "childrenPrefer": "b", "weighted": { "a": 4, "b": 1 }, "counted": 3 }, "note": "дети выбрали другой вариант — метка children_prefer у b" },
    { "id": "c006", "input": { "votes": [{ "voter": "t1", "group": "teacher", "choice": "a" }, { "voter": "u1", "group": "adult", "choice": "b" }, { "voter": "c1", "group": "child", "choice": "a" }, { "voter": "c2", "group": "child", "choice": "a" }, { "voter": "c3", "group": "child", "choice": "a" }, { "voter": "c4", "group": "child", "choice": "a" }, { "voter": "c5", "group": "child", "choice": "a" }] }, "expected": { "status": "escalated", "accepted": [], "main": null, "decidedBy": null, "childrenPrefer": null, "weighted": { "a": 8, "b": 2 }, "counted": 7 }, "note": "учителя за a, взрослые за b — к эксперту, хотя по весам a впереди" },
    { "id": "c007", "input": { "votes": [{ "voter": "t1", "group": "teacher", "choice": "a" }, { "voter": "t2", "group": "teacher", "choice": "a" }, { "voter": "u1", "group": "adult", "choice": "a" }, { "voter": "u2", "group": "adult", "choice": "b" }, { "voter": "u3", "group": "adult", "choice": "b" }] }, "expected": { "status": "escalated", "accepted": [], "main": null, "decidedBy": null, "childrenPrefer": null, "weighted": { "a": 8, "b": 4 }, "counted": 5 }, "note": "большинство учителей — a, большинство взрослых — b" },
    { "id": "c008", "input": { "votes": [{ "voter": "u1", "group": "adult", "choice": "a" }, { "voter": "u2", "group": "adult", "choice": "b" }, { "voter": "t1", "group": "teacher", "choice": "a" }] }, "expected": { "status": "accepted", "accepted": ["a"], "main": "a", "decidedBy": "rule", "childrenPrefer": null, "weighted": { "a": 5, "b": 2 }, "counted": 3 }, "note": "у взрослых ничья — большинства нет, расхождения нет" },
    { "id": "c009", "input": { "votes": [{ "voter": "u1", "group": "adult", "choice": "a" }, { "voter": "c1", "group": "child", "choice": "a" }, { "voter": "c2", "group": "child", "choice": "b" }] }, "expected": { "status": "accepted", "accepted": ["a"], "main": "a", "decidedBy": "rule", "childrenPrefer": null, "weighted": { "a": 3, "b": 1 }, "counted": 3 }, "note": "перевес ровно 2 — принят; у детей ничья — метки нет" },
    { "id": "c010", "input": { "votes": [{ "voter": "u1", "group": "adult", "choice": "a" }, { "voter": "c1", "group": "child", "choice": "b" }, { "voter": "c2", "group": "child", "choice": "both" }] }, "expected": { "status": "voting", "accepted": [], "main": null, "decidedBy": null, "childrenPrefer": null, "weighted": { "a": 2.5, "b": 1.5 }, "counted": 3 }, "note": "перевес 1 < 2 — ещё голосуем" },
    { "id": "c011", "input": { "votes": [{ "voter": "t1", "group": "teacher", "choice": "both" }, { "voter": "u1", "group": "adult", "choice": "a" }, { "voter": "c1", "group": "child", "choice": "a" }] }, "expected": { "status": "accepted", "accepted": ["a"], "main": "a", "decidedBy": "rule", "childrenPrefer": null, "weighted": { "a": 4.5, "b": 1.5 }, "counted": 3 }, "note": "both даёт по 0,5 веса обоим и считается голосом" },
    { "id": "c012", "input": { "votes": [{ "voter": "u1", "group": "adult", "choice": "a" }, { "voter": "c1", "group": "child", "choice": "a" }, { "voter": "c2", "group": "child", "choice": "skip" }, { "voter": "c3", "group": "child", "choice": "skip" }] }, "expected": { "status": "voting", "accepted": [], "main": null, "decidedBy": null, "childrenPrefer": null, "weighted": { "a": 3, "b": 0 }, "counted": 2 }, "note": "«Не знаю» не считается голосом" },
    { "id": "c013", "input": { "votes": [{ "voter": "u1", "group": "adult", "choice": "a" }, { "voter": "u2", "group": "adult", "choice": "b" }, { "voter": "c1", "group": "child", "choice": "b" }, { "voter": "u1", "group": "adult", "choice": "b" }] }, "expected": { "status": "accepted", "accepted": ["b"], "main": "b", "decidedBy": "rule", "childrenPrefer": null, "weighted": { "a": 0, "b": 5 }, "counted": 3 }, "note": "у участника учитывается последний голос" },
    { "id": "c014", "input": { "votes": [{ "voter": "u1", "group": "adult", "choice": "a" }, { "voter": "u2", "group": "adult", "choice": "a" }, { "voter": "u3", "group": "adult", "choice": "a" }, { "voter": "e1", "group": "expert", "choice": "b" }] }, "expected": { "status": "accepted", "accepted": ["b"], "main": "b", "decidedBy": "expert", "childrenPrefer": null, "weighted": { "a": 6, "b": 0 }, "counted": 3 }, "note": "эксперт решает окончательно, даже против большинства; его голос не входит в веса" },
    { "id": "c015", "input": { "votes": [{ "voter": "t1", "group": "teacher", "choice": "a" }, { "voter": "u1", "group": "adult", "choice": "b" }, { "voter": "e1", "group": "expert", "choice": "a" }] }, "expected": { "status": "accepted", "accepted": ["a"], "main": "a", "decidedBy": "expert", "childrenPrefer": null, "weighted": { "a": 3, "b": 2 }, "counted": 2 }, "note": "эскалация снята решением эксперта" },
    { "id": "c016", "input": { "votes": [{ "voter": "u1", "group": "adult", "choice": "a" }, { "voter": "e1", "group": "expert", "choice": "both" }] }, "expected": { "status": "accepted", "accepted": ["a", "b"], "main": null, "decidedBy": "expert", "childrenPrefer": null, "weighted": { "a": 2, "b": 0 }, "counted": 1 }, "note": "эксперт принял оба варианта — основного нет" },
    { "id": "c017", "input": { "votes": [{ "voter": "e1", "group": "expert", "choice": "skip" }, { "voter": "c1", "group": "child", "choice": "a" }, { "voter": "c2", "group": "child", "choice": "a" }, { "voter": "c3", "group": "child", "choice": "a" }] }, "expected": { "status": "voting", "accepted": [], "main": null, "decidedBy": null, "childrenPrefer": null, "weighted": { "a": 3, "b": 0 }, "counted": 3 }, "note": "«Не знаю» эксперта — не решение" },
    { "id": "c018", "input": { "votes": [{ "voter": "t1", "group": "teacher", "choice": "a" }, { "voter": "u1", "group": "adult", "choice": "a" }, { "voter": "c1", "group": "child", "choice": "b" }, { "voter": "c2", "group": "child", "choice": "b" }, { "voter": "c3", "group": "child", "choice": "b" }] }, "expected": { "status": "accepted", "accepted": ["a"], "main": "a", "decidedBy": "rule", "childrenPrefer": "b", "weighted": { "a": 5, "b": 3 }, "counted": 5 }, "note": "«так говорят дети»: главный — выбор старших групп, у b — метка" },
    { "id": "c019", "input": { "votes": [{ "voter": "u1", "group": "adult", "choice": "skip" }, { "voter": "c1", "group": "child", "choice": "a" }, { "voter": "c2", "group": "child", "choice": "a" }, { "voter": "c3", "group": "child", "choice": "a" }, { "voter": "c4", "group": "child", "choice": "a" }] }, "expected": { "status": "voting", "accepted": [], "main": null, "decidedBy": null, "childrenPrefer": null, "weighted": { "a": 4, "b": 0 }, "counted": 4 }, "note": "«Не знаю» взрослого — это не голос взрослого" },
    { "id": "c020", "input": { "votes": [{ "voter": "t1", "group": "teacher", "choice": "a" }, { "voter": "t2", "group": "teacher", "choice": "b" }, { "voter": "c1", "group": "child", "choice": "a" }, { "voter": "c2", "group": "child", "choice": "a" }] }, "expected": { "status": "accepted", "accepted": ["a"], "main": "a", "decidedBy": "rule", "childrenPrefer": null, "weighted": { "a": 5, "b": 3 }, "counted": 4 }, "note": "ничья учителей не мешает: решает общий взвешенный перевес" },
    { "id": "c021", "input": { "votes": [{ "voter": "u1", "group": "adult", "choice": "both" }, { "voter": "c1", "group": "child", "choice": "b" }, { "voter": "c2", "group": "child", "choice": "b" }] }, "expected": { "status": "accepted", "accepted": ["b"], "main": "b", "decidedBy": "rule", "childrenPrefer": null, "weighted": { "a": 1, "b": 3 }, "counted": 3 }, "note": "голос взрослого «оба» открывает принятие" },
    { "id": "c022", "input": { "votes": [{ "voter": "t1", "group": "teacher", "choice": "a" }, { "voter": "u1", "group": "adult", "choice": "b" }, { "voter": "u1", "group": "adult", "choice": "a" }, { "voter": "c1", "group": "child", "choice": "b" }] }, "expected": { "status": "accepted", "accepted": ["a"], "main": "a", "decidedBy": "rule", "childrenPrefer": "b", "weighted": { "a": 5, "b": 1 }, "counted": 3 }, "note": "взрослый передумал — расхождения больше нет" }
  ]
}
