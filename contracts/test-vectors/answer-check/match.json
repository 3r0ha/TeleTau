{
  "suite": "answer-check/match",
  "version": 1,
  "function": "matchAnswer",
  "description": "matchAnswer({ kind, answer, accepted }) — проверка ответа ученика по множеству принятых вариантов (docs/02 §4). Строки синтетические — сочетания букв, а не слова языка и не учебный контент. Правила — README.md этого каталога.",
  "cases": [
    { "id": "m001", "input": { "kind": "text", "answer": "пиҡол", "accepted": ["пиҡол"] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "точное совпадение" },
    { "id": "m002", "input": { "kind": "text", "answer": "ПИҠОЛ", "accepted": ["пиҡол"] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "регистр не важен (заглавная Ҡ)" },
    { "id": "m003", "input": { "kind": "text", "answer": "пиҡол тумә", "accepted": ["Пиҡол тумә."] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "точка и регистр в принятом варианте не важны" },
    { "id": "m004", "input": { "kind": "text", "answer": "  Пиҡол,  тумә!!  ", "accepted": ["пиҡол тумә"] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "пунктуация и лишние пробелы в ответе" },
    { "id": "m005", "input": { "kind": "text", "answer": "«Пиҡол — тумә»", "accepted": ["пиҡол тумә"] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "кавычки-ёлочки и тире — пунктуация" },
    { "id": "m006", "input": { "kind": "text", "answer": "пиҡол  тумә", "accepted": ["пиҡол тумә"] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "неразрывные пробелы" },
    { "id": "m007", "input": { "kind": "text", "answer": "пиҡoл", "accepted": ["пиҡол"] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "латинская o внутри кириллического слова → о" },
    { "id": "m008", "input": { "kind": "text", "answer": "тумə", "accepted": ["тумә"] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "латинская шва U+0259 → ә" },
    { "id": "m009", "input": { "kind": "text", "answer": "пиқол", "accepted": ["пиҡол"] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "казахская қ U+049B → ҡ" },
    { "id": "m010", "input": { "kind": "text", "answer": "пис̧ол", "accepted": ["пиҫол"] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "с + комбинирующая седиль → ҫ" },
    { "id": "m011", "input": { "kind": "text", "answer": "пиhол", "accepted": ["пиһол"] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "латинская h внутри кириллического слова → һ" },
    { "id": "m012", "input": { "kind": "text", "answer": "пикол", "accepted": ["пиҡол"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "ҡ", "got": "к", "token": 0, "index": 2 } }, "note": "почти: к вместо ҡ" },
    { "id": "m013", "input": { "kind": "text", "answer": "пигол", "accepted": ["пиғол"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "ғ", "got": "г", "token": 0, "index": 2 } }, "note": "почти: г вместо ғ" },
    { "id": "m014", "input": { "kind": "text", "answer": "пизол", "accepted": ["пиҙол"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "ҙ", "got": "з", "token": 0, "index": 2 } }, "note": "почти: з вместо ҙ" },
    { "id": "m015", "input": { "kind": "text", "answer": "писол", "accepted": ["пиҫол"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "ҫ", "got": "с", "token": 0, "index": 2 } }, "note": "почти: с вместо ҫ" },
    { "id": "m016", "input": { "kind": "text", "answer": "пихол", "accepted": ["пиһол"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "һ", "got": "х", "token": 0, "index": 2 } }, "note": "почти: х вместо һ" },
    { "id": "m017", "input": { "kind": "text", "answer": "пиаол", "accepted": ["пиәол"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "ә", "got": "а", "token": 0, "index": 2 } }, "note": "почти: а вместо ә" },
    { "id": "m018", "input": { "kind": "text", "answer": "пиоол", "accepted": ["пиөол"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "ө", "got": "о", "token": 0, "index": 2 } }, "note": "почти: о вместо ө" },
    { "id": "m019", "input": { "kind": "text", "answer": "пиуол", "accepted": ["пиүол"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "ү", "got": "у", "token": 0, "index": 2 } }, "note": "почти: у вместо ү" },
    { "id": "m020", "input": { "kind": "text", "answer": "пинол", "accepted": ["пиңол"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "ң", "got": "н", "token": 0, "index": 2 } }, "note": "почти: н вместо ң" },
    { "id": "m021", "input": { "kind": "text", "answer": "ТУМӘ ПИКОЛ", "accepted": ["Тумә пиҡол"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "ҡ", "got": "к", "token": 1, "index": 2 } }, "note": "почти во втором слове; буквы подсказки — строчные" },
    { "id": "m022", "input": { "kind": "text", "answer": "пиҡол", "accepted": ["пикол"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "к", "got": "ҡ", "token": 0, "index": 2 } }, "note": "обратное направление: ҡ вместо к" },
    { "id": "m023", "input": { "kind": "text", "answer": "кипоз", "accepted": ["ҡипоҙ"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "ҡ", "got": "к", "token": 0, "index": 0 } }, "note": "две особые буквы — подсказка про первую" },
    { "id": "m024", "input": { "kind": "text", "answer": "пелу", "accepted": ["пёлу"] }, "expected": { "verdict": "almost", "matched": 0, "hint": { "expected": "ё", "got": "е", "token": 0, "index": 1 } }, "note": "ё/е тоже сворачивается (fold) — «почти»" },
    { "id": "m025", "input": { "kind": "text", "answer": "пиҡолтен", "accepted": ["пиҡолтан"] }, "expected": { "verdict": "typo", "matched": 0 }, "note": "опечатка: замена буквы в слове из 8 букв" },
    { "id": "m026", "input": { "kind": "text", "answer": "пиҡлан", "accepted": ["пиҡолан"] }, "expected": { "verdict": "typo", "matched": 0 }, "note": "опечатка: пропущена буква" },
    { "id": "m027", "input": { "kind": "text", "answer": "пиҡоллан", "accepted": ["пиҡолан"] }, "expected": { "verdict": "typo", "matched": 0 }, "note": "опечатка: лишняя буква" },
    { "id": "m028", "input": { "kind": "text", "answer": "пиҡлоан", "accepted": ["пиҡолан"] }, "expected": { "verdict": "typo", "matched": 0 }, "note": "опечатка: переставлены соседние буквы" },
    { "id": "m029", "input": { "kind": "text", "answer": "пиколна", "accepted": ["пиҡолан"] }, "expected": { "verdict": "typo", "matched": 0 }, "note": "опечатка и к вместо ҡ в том же слове — опечатка (после свёртки)" },
    { "id": "m030", "input": { "kind": "text", "answer": "пиҡал", "accepted": ["пиҡол"] }, "expected": { "verdict": "typo", "matched": 0 }, "note": "граница: слово из 5 букв — уже длинное" },
    { "id": "m031", "input": { "kind": "text", "answer": "тымә", "accepted": ["тумә"] }, "expected": { "verdict": "wrong" }, "note": "граница: слово из 4 букв — опечатка не прощается" },
    { "id": "m032", "input": { "kind": "text", "answer": "пуҡолон", "accepted": ["пиҡолан"] }, "expected": { "verdict": "wrong" }, "note": "две ошибки в одном слове" },
    { "id": "m033", "input": { "kind": "text", "answer": "пиҡолен тумәлак", "accepted": ["пиҡолан тумәлек"] }, "expected": { "verdict": "wrong" }, "note": "по опечатке в двух словах" },
    { "id": "m034", "input": { "kind": "text", "answer": "пиҡолен тумалек", "accepted": ["пиҡолан тумәлек"] }, "expected": { "verdict": "typo", "matched": 0 }, "note": "опечатка в одном слове, во втором только а вместо ә — опечатка" },
    { "id": "m035", "input": { "kind": "text", "answer": "пиҡол", "accepted": ["пиҡол тумә"] }, "expected": { "verdict": "wrong" }, "note": "пропущено слово" },
    { "id": "m036", "input": { "kind": "text", "answer": "пиҡол тумә зыр", "accepted": ["пиҡол тумә"] }, "expected": { "verdict": "wrong" }, "note": "лишнее слово" },
    { "id": "m037", "input": { "kind": "text", "answer": "зырпы", "accepted": ["пиҡол"] }, "expected": { "verdict": "wrong" }, "note": "совсем другое" },
    { "id": "m038", "input": { "kind": "text", "answer": "", "accepted": ["пиҡол"] }, "expected": { "verdict": "wrong" }, "note": "пустой ответ" },
    { "id": "m039", "input": { "kind": "text", "answer": " !!! ", "accepted": ["пиҡол"] }, "expected": { "verdict": "wrong" }, "note": "только пунктуация" },
    { "id": "m040", "input": { "kind": "text", "answer": "тумә пиҡол", "accepted": ["пиҡол тумә", "тумә пиҡол"] }, "expected": { "verdict": "correct", "matched": 1 }, "note": "совпал второй принятый вариант" },
    { "id": "m041", "input": { "kind": "text", "answer": "пиҡол", "accepted": ["пикол", "пиҡол"] }, "expected": { "verdict": "correct", "matched": 1 }, "note": "верное совпадение важнее «почти» с более ранним вариантом" },
    { "id": "m042", "input": { "kind": "text", "answer": "пикол тумә", "accepted": ["пиҡолтан", "пиҡол тумә"] }, "expected": { "verdict": "almost", "matched": 1, "hint": { "expected": "ҡ", "got": "к", "token": 0, "index": 2 } }, "note": "«почти» — по первому подходящему варианту" },
    { "id": "m043", "input": { "kind": "text", "answer": "пиҡ-пиҡ", "accepted": ["Пиҡ-пиҡ!"] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "дефис между буквами — часть слова" },
    { "id": "m044", "input": { "kind": "text", "answer": "пиҡ пиҡ", "accepted": ["пиҡ-пиҡ"] }, "expected": { "verdict": "wrong" }, "note": "дефис вместо пробела — другое число слов" },
    { "id": "m045", "input": { "kind": "text", "answer": "- пиҡол -", "accepted": ["пиҡол"] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "дефис не между буквами — пунктуация" },
    { "id": "m046", "input": { "kind": "tiles", "answer": ["Пиҡол", "тумә", "зыр"], "accepted": ["Пиҡол тумә зыр."] }, "expected": { "verdict": "correct", "matched": 0 }, "note": "плитки в верном порядке" },
    { "id": "m047", "input": { "kind": "tiles", "answer": ["тумә", "Пиҡол", "зыр"], "accepted": ["Пиҡол тумә зыр."] }, "expected": { "verdict": "wrong" }, "note": "порядок плиток важен" },
    { "id": "m048", "input": { "kind": "tiles", "answer": ["Пиҡол", "тумә"], "accepted": ["Пиҡол тумә зыр."] }, "expected": { "verdict": "wrong" }, "note": "не хватает плитки" },
    { "id": "m049", "input": { "kind": "tiles", "answer": ["Пиҡол", "тумә", "зыр", "мыр"], "accepted": ["Пиҡол тумә зыр."] }, "expected": { "verdict": "wrong" }, "note": "лишняя плитка" },
    { "id": "m050", "input": { "kind": "tiles", "answer": ["Пикол", "тумә", "зыр"], "accepted": ["Пиҡол тумә зыр."] }, "expected": { "verdict": "wrong" }, "note": "у плиток нет «почти»: плитка с к вместо ҡ — другая плитка" },
    { "id": "m051", "input": { "kind": "tiles", "answer": [], "accepted": ["Пиҡол тумә зыр."] }, "expected": { "verdict": "wrong" }, "note": "ни одной плитки" }
  ]
}
