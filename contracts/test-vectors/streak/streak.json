{
  "suite": "streak/streak",
  "version": 1,
  "function": "computeStreak",
  "description": "computeStreak({ completions, now }) — серия по суткам Уфы (Asia/Yekaterinburg, UTC+5), пересчитываемая из моментов завершения уроков (UTC, RFC 3339). Цель дня — 1 урок. Пропуск списывает заморозку, без заморозки серия обнуляется; старт с 2 заморозками, +1 за каждые 7 дней подряд, максимум 2. week — неделя пн–вс, в которую попадает сегодня. Правила — README.md этого каталога.",
  "cases": [
    { "id": "s001", "input": { "completions": [], "now": "2026-11-04T07:00:00Z" }, "expected": { "today": "2026-11-04", "current": 0, "longest": 0, "freezes": 2, "extendedToday": false, "frozenDays": [], "weekStart": "2026-11-02", "week": ["missed", "missed", "today", "future", "future", "future", "future"] }, "note": "занятий нет: серии нет, заморозки целы" },
    { "id": "s002", "input": { "completions": ["2026-11-04T07:00:00Z"], "now": "2026-11-04T09:00:00Z" }, "expected": { "today": "2026-11-04", "current": 1, "longest": 1, "freezes": 2, "extendedToday": true, "frozenDays": [], "weekStart": "2026-11-02", "week": ["missed", "missed", "done", "future", "future", "future", "future"] }, "note": "первый урок сегодня; дни до первого занятия заморозки не тратят" },
    { "id": "s003", "input": { "completions": ["2026-11-03T18:59:59Z", "2026-11-03T19:00:00Z"], "now": "2026-11-04T10:00:00Z" }, "expected": { "today": "2026-11-04", "current": 2, "longest": 2, "freezes": 2, "extendedToday": true, "frozenDays": [], "weekStart": "2026-11-02", "week": ["missed", "done", "done", "future", "future", "future", "future"] }, "note": "граница суток Уфы: 18:59:59Z — ещё 3-е, 19:00:00Z — уже 4-е" },
    { "id": "s004", "input": { "completions": ["2026-11-03T20:00:00Z", "2026-11-04T07:00:00Z"], "now": "2026-11-04T12:00:00Z" }, "expected": { "today": "2026-11-04", "current": 1, "longest": 1, "freezes": 2, "extendedToday": true, "frozenDays": [], "weekStart": "2026-11-02", "week": ["missed", "missed", "done", "future", "future", "future", "future"] }, "note": "две даты UTC, но одни сутки Уфы — один день серии" },
    { "id": "s005", "input": { "completions": ["2026-10-30T07:00:00Z", "2026-10-31T07:00:00Z", "2026-11-01T07:00:00Z", "2026-11-02T07:00:00Z", "2026-11-03T07:00:00Z"], "now": "2026-11-04T07:00:00Z" }, "expected": { "today": "2026-11-04", "current": 5, "longest": 5, "freezes": 2, "extendedToday": false, "frozenDays": [], "weekStart": "2026-11-02", "week": ["done", "done", "today", "future", "future", "future", "future"] }, "note": "5 дней подряд по вчера; сегодня цель ещё не выполнена — серия жива" },
    { "id": "s006", "input": { "completions": ["2026-10-31T07:00:00Z", "2026-11-01T07:00:00Z", "2026-11-03T07:00:00Z"], "now": "2026-11-03T09:00:00Z" }, "expected": { "today": "2026-11-03", "current": 3, "longest": 3, "freezes": 1, "extendedToday": true, "frozenDays": ["2026-11-02"], "weekStart": "2026-11-02", "week": ["frozen", "done", "future", "future", "future", "future", "future"] }, "note": "пропуск списал заморозку; замороженный день серию не удлиняет" },
    { "id": "s007", "input": { "completions": ["2026-10-30T07:00:00Z", "2026-10-31T07:00:00Z", "2026-11-03T07:00:00Z"], "now": "2026-11-03T09:00:00Z" }, "expected": { "today": "2026-11-03", "current": 3, "longest": 3, "freezes": 0, "extendedToday": true, "frozenDays": ["2026-11-01", "2026-11-02"], "weekStart": "2026-11-02", "week": ["frozen", "done", "future", "future", "future", "future", "future"] }, "note": "два пропуска подряд — обе заморозки" },
    { "id": "s008", "input": { "completions": ["2026-10-29T07:00:00Z", "2026-10-30T07:00:00Z", "2026-11-03T07:00:00Z"], "now": "2026-11-03T09:00:00Z" }, "expected": { "today": "2026-11-03", "current": 1, "longest": 2, "freezes": 0, "extendedToday": true, "frozenDays": ["2026-10-31", "2026-11-01"], "weekStart": "2026-11-02", "week": ["missed", "done", "future", "future", "future", "future", "future"] }, "note": "третий пропуск без заморозки обнуляет серию; сегодня — новая серия" },
    { "id": "s009", "input": { "completions": ["2026-10-20T07:00:00Z", "2026-10-21T07:00:00Z", "2026-10-22T07:00:00Z", "2026-10-24T07:00:00Z", "2026-10-25T07:00:00Z", "2026-10-26T07:00:00Z", "2026-10-27T07:00:00Z", "2026-10-28T07:00:00Z", "2026-10-29T07:00:00Z", "2026-10-30T07:00:00Z"], "now": "2026-10-30T12:00:00Z" }, "expected": { "today": "2026-10-30", "current": 10, "longest": 10, "freezes": 2, "extendedToday": true, "frozenDays": ["2026-10-23"], "weekStart": "2026-10-26", "week": ["done", "done", "done", "done", "done", "future", "future"] }, "note": "после заморозки 7 дней подряд возвращают заморозку (1 → 2)" },
    { "id": "s010", "input": { "completions": ["2026-10-26T07:00:00Z", "2026-10-27T07:00:00Z", "2026-10-28T07:00:00Z", "2026-10-29T07:00:00Z", "2026-10-30T07:00:00Z", "2026-10-31T07:00:00Z", "2026-11-01T07:00:00Z"], "now": "2026-11-01T12:00:00Z" }, "expected": { "today": "2026-11-01", "current": 7, "longest": 7, "freezes": 2, "extendedToday": true, "frozenDays": [], "weekStart": "2026-10-26", "week": ["done", "done", "done", "done", "done", "done", "done"] }, "note": "7 дней подряд при полном запасе — не больше 2 заморозок" },
    { "id": "s011", "input": { "completions": ["2026-10-01T07:00:00Z", "2026-10-04T07:00:00Z", "2026-10-05T07:00:00Z", "2026-10-06T07:00:00Z", "2026-10-07T07:00:00Z", "2026-10-08T07:00:00Z", "2026-10-09T07:00:00Z", "2026-10-10T07:00:00Z", "2026-10-11T07:00:00Z", "2026-10-12T07:00:00Z", "2026-10-13T07:00:00Z", "2026-10-14T07:00:00Z", "2026-10-15T07:00:00Z", "2026-10-16T07:00:00Z", "2026-10-17T07:00:00Z"], "now": "2026-10-17T12:00:00Z" }, "expected": { "today": "2026-10-17", "current": 15, "longest": 15, "freezes": 2, "extendedToday": true, "frozenDays": ["2026-10-02", "2026-10-03"], "weekStart": "2026-10-12", "week": ["done", "done", "done", "done", "done", "done", "future"] }, "note": "обе заморозки потрачены, затем 14 дней подряд — +1 и ещё +1" },
    { "id": "s012", "input": { "completions": ["2026-10-26T07:00:00Z", "2026-10-27T07:00:00Z", "2026-10-28T07:00:00Z", "2026-10-29T07:00:00Z", "2026-10-30T07:00:00Z", "2026-11-03T07:00:00Z"], "now": "2026-11-04T07:00:00Z" }, "expected": { "today": "2026-11-04", "current": 1, "longest": 5, "freezes": 0, "extendedToday": false, "frozenDays": ["2026-10-31", "2026-11-01"], "weekStart": "2026-11-02", "week": ["missed", "done", "today", "future", "future", "future", "future"] }, "note": "после обнуления лучшая серия сохраняется" },
    { "id": "s013", "input": { "completions": ["2026-11-04T19:30:00Z"], "now": "2026-11-04T20:30:00Z" }, "expected": { "today": "2026-11-05", "current": 1, "longest": 1, "freezes": 2, "extendedToday": true, "frozenDays": [], "weekStart": "2026-11-02", "week": ["missed", "missed", "missed", "done", "future", "future", "future"] }, "note": "в Уфе уже 5-е, хотя по UTC ещё 4-е" },
    { "id": "s014", "input": { "completions": ["2026-10-28T07:00:00Z", "2026-11-02T07:00:00Z"], "now": "2026-11-02T12:00:00Z" }, "expected": { "today": "2026-11-02", "current": 1, "longest": 1, "freezes": 0, "extendedToday": true, "frozenDays": ["2026-10-29", "2026-10-30"], "weekStart": "2026-11-02", "week": ["done", "future", "future", "future", "future", "future", "future"] }, "note": "после обнуления пропуски заморозки не тратят (их и нет)" },
    { "id": "s015", "input": { "completions": ["2026-11-01T07:00:00Z", "2026-11-02T07:00:00Z"], "now": "2026-11-04T07:00:00Z" }, "expected": { "today": "2026-11-04", "current": 2, "longest": 2, "freezes": 1, "extendedToday": false, "frozenDays": ["2026-11-03"], "weekStart": "2026-11-02", "week": ["done", "frozen", "today", "future", "future", "future", "future"] }, "note": "вчерашний пропуск уже закрыт заморозкой, сегодня цель ещё впереди" },
    { "id": "s016", "input": { "completions": ["2026-11-08T07:00:00Z"], "now": "2026-11-08T19:30:00Z" }, "expected": { "today": "2026-11-09", "current": 1, "longest": 1, "freezes": 2, "extendedToday": false, "frozenDays": [], "weekStart": "2026-11-09", "week": ["today", "future", "future", "future", "future", "future", "future"] }, "note": "в Уфе наступил понедельник — новая неделя" },
    { "id": "s017", "input": { "completions": ["2026-11-04T07:00:00Z", "2026-11-02T07:00:00Z", "2026-11-03T07:00:00Z", "2026-11-03T08:00:00Z"], "now": "2026-11-04T09:00:00Z" }, "expected": { "today": "2026-11-04", "current": 3, "longest": 3, "freezes": 2, "extendedToday": true, "frozenDays": [], "weekStart": "2026-11-02", "week": ["done", "done", "done", "future", "future", "future", "future"] }, "note": "порядок и повторы моментов не важны" }
  ]
}
