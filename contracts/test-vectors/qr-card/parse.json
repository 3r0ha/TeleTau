{
  "suite": "qr-card/parse",
  "version": 2,
  "function": "parseQrPayload",
  "cases": [
    { "id": "p001", "input": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V", "expected": { "ok": true, "seat": "0123456789", "secret": "ABCDEFGHJKMNPQRSTVWXYZ0123", "payload": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V" }, "note": "каноническая полезная нагрузка" },
    { "id": "p002", "input": "https://teletau.study/q#TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V", "expected": { "ok": true, "seat": "0123456789", "secret": "ABCDEFGHJKMNPQRSTVWXYZ0123", "payload": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V" }, "note": "полная ссылка из QR: берётся фрагмент после первого #" },
    { "id": "p003", "input": "http://localhost:3000/q?utm=1#TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V", "expected": { "ok": true, "seat": "0123456789", "secret": "ABCDEFGHJKMNPQRSTVWXYZ0123", "payload": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V" }, "note": "любой базовый адрес и запрос до # не важны" },
    { "id": "p004", "input": "tt1.0123456789.abcdefghjkmnpqrstvwxyz0123.6v", "expected": { "ok": true, "seat": "0123456789", "secret": "ABCDEFGHJKMNPQRSTVWXYZ0123", "payload": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V" }, "note": "нижний регистр" },
    { "id": "p005", "input": "  TT1.01234 56789.ABCDE FGHJK MNPQR STVWX YZ012 3.6V\n", "expected": { "ok": true, "seat": "0123456789", "secret": "ABCDEFGHJKMNPQRSTVWXYZ0123", "payload": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V" }, "note": "пробелы по краям и внутри, перевод строки" },
    { "id": "p006", "input": "TT1.01234-56789.ABCDE–FGHJK‐MNPQR STVWX\tYZ0123.6V", "expected": { "ok": true, "seat": "0123456789", "secret": "ABCDEFGHJKMNPQRSTVWXYZ0123", "payload": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V" }, "note": "дефис, короткое тире, U+2010, неразрывный пробел и табуляция удаляются" },
    { "id": "p007", "input": "TT1.O123456789.ABCDEFGHJKMNPQRSTVWXYZo123.6V", "expected": { "ok": true, "seat": "0123456789", "secret": "ABCDEFGHJKMNPQRSTVWXYZ0123", "payload": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V" }, "note": "буква O/o вместо нуля" },
    { "id": "p008", "input": "TTI.0I23456789.ABCDEFGHJKMNPQRSTVWXYZ0l23.6V", "expected": { "ok": true, "seat": "0123456789", "secret": "ABCDEFGHJKMNPQRSTVWXYZ0123", "payload": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V" }, "note": "I и l вместо единицы, в том числе в префиксе" },
    { "id": "p009", "input": "ТТ1.0123456789.АВСDЕFGНJКМNРQRSТVWХYZ0123.6V", "expected": { "ok": true, "seat": "0123456789", "secret": "ABCDEFGHJKMNPQRSTVWXYZ0123", "payload": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V" }, "note": "кириллические двойники заглавных (К А В С Е Н М Р Т Х) — набрано в русской раскладке" },
    { "id": "p010", "input": "TT1.0000000000.00000000000000000000000000.00", "expected": { "ok": true, "seat": "0000000000", "secret": "00000000000000000000000000", "payload": "TT1.0000000000.00000000000000000000000000.00" }, "note": "все нули: контрольная сумма 00" },
    { "id": "p011", "input": "TT1.ZZZZZZZZZZ.ZZZZZZZZZZZZZZZZZZZZZZZZZZ.ZS", "expected": { "ok": true, "seat": "ZZZZZZZZZZ", "secret": "ZZZZZZZZZZZZZZZZZZZZZZZZZZ", "payload": "TT1.ZZZZZZZZZZ.ZZZZZZZZZZZZZZZZZZZZZZZZZZ.ZS" }, "note": "все символы максимальные (31)" },
    { "id": "p012", "input": "TT1.7M2QK9XD4T.H3VN8RZ6P1CWEA0FJ5GKY2SB7Q.GJ", "expected": { "ok": true, "seat": "7M2QK9XD4T", "secret": "H3VN8RZ6P1CWEA0FJ5GKY2SB7Q", "payload": "TT1.7M2QK9XD4T.H3VN8RZ6P1CWEA0FJ5GKY2SB7Q.GJ" }, "note": "случайная карточка" },
    { "id": "p013", "input": "tt1.n4f8w2pcz0.1qx7t3mkd9vra6h0bj5gye2s8c.f3", "expected": { "ok": true, "seat": "N4F8W2PCZ0", "secret": "1QX7T3MKD9VRA6H0BJ5GYE2S8C", "payload": "TT1.N4F8W2PCZ0.1QX7T3MKD9VRA6H0BJ5GYE2S8C.F3" }, "note": "случайная карточка в нижнем регистре" },
    { "id": "p014", "input": "тт1.0123456789.авсdеfgнjкмnрqrsтvwхyzо123.6v", "expected": { "ok": true, "seat": "0123456789", "secret": "ABCDEFGHJKMNPQRSTVWXYZ0123", "payload": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V" }, "note": "кириллические двойники строчных, о → 0" },
    { "id": "e001", "input": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0124.6V", "expected": { "ok": false, "error": "bad_checksum" }, "note": "опечатка в последнем символе секрета" },
    { "id": "e002", "input": "TT1.0123456789.BACDEFGHJKMNPQRSTVWXYZ0123.6V", "expected": { "ok": false, "error": "bad_checksum" }, "note": "перестановка соседних символов секрета" },
    { "id": "e003", "input": "TT1.1023456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V", "expected": { "ok": false, "error": "bad_checksum" }, "note": "перестановка соседних символов места" },
    { "id": "e004", "input": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6W", "expected": { "ok": false, "error": "bad_checksum" }, "note": "опечатка в контрольной сумме" },
    { "id": "e005", "input": "XY1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V", "expected": { "ok": false, "error": "unknown_prefix" }, "note": "чужой префикс" },
    { "id": "e006", "input": "TT2.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V", "expected": { "ok": false, "error": "unsupported_version" }, "note": "наш формат, но версия, которую порт не знает" },
    { "id": "e007", "input": "hello world", "expected": { "ok": false, "error": "unknown_prefix" }, "note": "мусор" },
    { "id": "e008", "input": "https://example.com/other/page", "expected": { "ok": false, "error": "unknown_prefix" }, "note": "чужая ссылка без фрагмента" },
    { "id": "e009", "input": "", "expected": { "ok": false, "error": "empty" }, "note": "пустая строка" },
    { "id": "e010", "input": "  \t- ", "expected": { "ok": false, "error": "empty" }, "note": "только пробелы и дефисы" },
    { "id": "e011", "input": "https://teletau.study/q#", "expected": { "ok": false, "error": "empty" }, "note": "ссылка с пустым фрагментом" },
    { "id": "e012", "input": "TT1", "expected": { "ok": false, "error": "invalid_format" }, "note": "только префикс" },
    { "id": "e013", "input": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ012.6V", "expected": { "ok": false, "error": "invalid_format" }, "note": "секрет короче 26 символов" },
    { "id": "e014", "input": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V.00", "expected": { "ok": false, "error": "invalid_format" }, "note": "лишний сегмент" },
    { "id": "e015", "input": "TT1.012345678.ABCDEFGHJKMNPQRSTVWXYZ0123.6V", "expected": { "ok": false, "error": "invalid_format" }, "note": "место короче 10 символов" },
    { "id": "e016", "input": "TT1.0123456789.ABCDEFGHJKMNPQRSTUWXYZ0123.6V", "expected": { "ok": false, "error": "invalid_character" }, "note": "U не входит в алфавит Crockford" },
    { "id": "e017", "input": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ01*3.6V", "expected": { "ok": false, "error": "invalid_character" }, "note": "посторонний знак" },
    { "id": "e018", "input": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ01Ҡ3.6V", "expected": { "ok": false, "error": "invalid_character" }, "note": "башкирская Ҡ не превращается в K" },
    { "id": "e019", "input": "TT1.0123456789.ABCDEFGHJKMNPQRSTVWXYZ0123.6V#", "expected": { "ok": false, "error": "empty" }, "note": "ссылка, оканчивающаяся на #: фрагмент после первого # пуст" },
    { "id": "e020", "input": "TT1..ABCDEFGHJKMNPQRSTVWXYZ0123.6V", "expected": { "ok": false, "error": "invalid_format" }, "note": "пустой сегмент места" }
  ]
}
