# Локальное окружение (docker-compose.yml). Скопируйте в .env при необходимости переопределить.
POSTGRES_HOST_PORT=15432
VALKEY_HOST_PORT=16379
CLICKHOUSE_HOST_PORT=18123
S3_HOST_PORT=18333

DATABASE_URL=postgres://teletau:teletau@localhost:15432/teletau
VALKEY_URL=redis://localhost:16379
CLICKHOUSE_URL=http://teletau:teletau@localhost:18123/teletau
S3_ENDPOINT=http://localhost:18333
S3_ACCESS_KEY=teletau
S3_SECRET_KEY=teletau-local-secret

# Без телеметрии Next.js во внешние сервисы (ADR 0012)
NEXT_TELEMETRY_DISABLED=1

# Таймауты внешних вызовов (docs/06-architecture.md §6.8). Значения по умолчанию заданы в коде.
# DB_QUERY_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=4000
# VALKEY_COMMAND_TIMEOUT_MS=2000
# VALKEY_SOCKET_TIMEOUT_MS=3000
# VALKEY_WORKER_SOCKET_TIMEOUT_MS=15000

API_PORT=4000
AI_GATEWAY_PORT=4100
ML_WORKER_PORT=4200
WEB_PORT=3000
CONSOLE_PORT=3100

# Адреса для ссылок и CORS. Адрес веба печатается на QR-карточке текстом; в самом QR — только полезная нагрузка TT1.… (ADR 0016)
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_CONSOLE_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4000
# Ссылка на APK Android-приложения: стартовая страница веба показывает кнопку «Скачать для Android» и ссылку в подвале.
# Читается сервером при каждом запросе (не NEXT_PUBLIC_, пересборка не нужна; dev-сервер — перезапустить).
# Пусто — кнопки нет. Только http:// или https://. Пример стенда в локальной сети: http://192.168.1.232:8080/teletau.apk
ANDROID_APK_URL=

# Вход и сессии (ADR 0015). Почтового сервиса пока нет: вход взрослых — e-mail + фиксированный демо-код.
# AUTH_DEMO_OTP — демо-режим: письмо не отправляется, принимается этот код (4–6 цифр). Пусто — демо-режим выключен,
# и без почтового провайдера POST /auth/otp/request отвечает 503. В проде не задавать.
AUTH_DEMO_OTP=0000
# Постоянный код класса для показа: «Показать код класса» выдаёт классу этот код (6 символов base32 Crockford,
# на доске — «000-000») на год, «Закрыть код класса» его не гасит; заявки по нему учитель одобряет как обычно.
# Код один на стенд: выпуск для другого класса снимает его с прежнего. Пусто — обычные коды на 15 минут.
# Сквозные тесты его не используют (e2e/run.mjs снимает), в production запрещено проверкой конфигурации.
AUTH_DEMO_CLASS_CODE=000000
# Демо-сотрудники консоли (модератор и администратор с TOTP-секретами из apps/api/data/README.md) — отдельно от демо-кода:
# 1 — завести их при старте API (dev, e2e, тесты); пусто или 0 — не заводить, а заведённых раньше заблокировать.
# В проде запрещено проверкой конфигурации.
AUTH_DEMO_STAFF=1
# Демо без второго фактора для показа жюри: 1 — вход сотрудника «почта → код», шаг TOTP пропускается.
# Только вместе с AUTH_DEMO_STAFF, в production запрещено проверкой конфигурации.
AUTH_DEMO_STAFF_WITHOUT_TOTP=1
# Кнопка «Скачать для Android» на лендинге: https-ссылка на APK (кладём в apps/web/public/teletau.apk,
# сборка — docs/deploy.md «Мобильное приложение»). Пусто — кнопки нет.
ANDROID_APK_URL=
# Ключ подписи access-токенов ES256 (PKCS#8 PEM). Пусто — только в dev: API создаёт временный ключ при старте.
AUTH_JWT_PRIVATE_KEY=
# Перец для HMAC-хешей e-mail, кода класса и IP (ADR 0015–0017). В проде — из Lockbox, не короче 32 символов.
AUTH_SECRET_PEPPER=dev-only-pepper-not-for-production
# Кому доверять X-Forwarded-For: false, true, число прокси-хопов или адреса и подсети через запятую.
# Вход по QR и коду класса идёт через BFF Next.js (/api/session/…), и он передаёт IP браузера в X-Forwarded-For.
# В dev веб и консоль работают на этом же компьютере — доверяем только loopback, и лимиты частоты считаются по IP
# ученика, а не по IP сервера Next. В проде — адреса или подсети балансировщика и BFF (или число хопов).
TRUST_PROXY=loopback
# BFF веба и консоли: какой IP браузера передавать в API. Присланный клиентом X-Forwarded-For не пересылается
# никогда: IP — адрес сокета запроса к Next.js. Если перед Next.js стоит свой балансировщик — его адреса и подсети
# через запятую (или loopback, linklocal, uniquelocal): тогда берётся адрес, который дописал балансировщик.
# Пусто (dev: браузер ходит в Next напрямую) — только адрес сокета.
BFF_TRUST_PROXY=
# Таймаут вызова API из BFF, мс (docs/06-architecture.md §6.8); по умолчанию 10000.
# BFF_API_TIMEOUT_MS=10000
# Ключ AES-256-GCM (base64, 32 байта) для TOTP-секретов сотрудников и заданий печати карточек. Пусто — только в dev.
AUTH_ENCRYPTION_KEY=

# Telegram-бот и Mini App (ADR 0007, 0020; как получить токен — docs/demo/M2.md, раздел «Telegram Mini App»).
# TELEGRAM_BOT_TOKEN — токен от @BotFather: им бот работает (long polling), а API проверяет подпись initData Mini App.
# Пусто — бот не стартует (пишет, что делать), привязка Telegram в API отвечает 503, остальное работает.
TELEGRAM_BOT_TOKEN=
# Адрес Mini App для кнопок «Учиться» и кнопки меню — только https:// (Telegram не открывает Mini App по http).
# Пусто или http:// — бот работает без кнопки Mini App.
TELEGRAM_MINIAPP_URL=
# Username бота (без @) для строки «Привязать Telegram» в профиле веба: t.me/<username>?start=<код>.
# Пусто — строки привязки нет (миниапп привязывается сам через initData).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Куда бот ходит за служебными операциями (привязка, напоминания о серии).
BOT_API_URL=http://localhost:4000
# Секрет служебных операций бота (заголовок X-Service-Token, роль service) — одинаковый у API и бота.
# В проде — свой, не короче 32 символов (из Lockbox); dev-значение API в production не примет.
BOT_SERVICE_TOKEN=dev-only-bot-service-token-not-for-production
# Как часто бот спрашивает API «кому напомнить», секунды (по умолчанию 60).
# BOT_REMINDER_INTERVAL_SECONDS=60
# GigaChat (apps/ai-gateway): без ключа — мок-провайдер, объяснения ошибок шаблонные
GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2-Pro
# Корень НУЦ Минцифры для TLS к api.giga.chat (Госуслуги → сертификаты НУЦ; файл НЕ в git)
# GIGACHAT_CA_FILE=apps/ai-gateway/certs/russian_trusted_root_ca.pem
# API → шлюз: адрес и (опционально) общий секрет Bearer; шлюз слушает 127.0.0.1:4100
# AI_GATEWAY_URL=http://127.0.0.1:4100
# AI_GATEWAY_TOKEN=
# Лимит объяснений ошибок на аккаунт в учебные сутки (docs/04 §5.5)
# AI_EXPLANATION_LIMIT=10
